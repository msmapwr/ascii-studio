<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>asciistudio-cli</AssemblyName>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Version>1.0.0-alpha.3</Version>
    <StudioArchitecture Condition="'$(StudioArchitecture)' == ''">x64</StudioArchitecture>
    <RuntimeIdentifier>win-$(StudioArchitecture)</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>$(StudioArchitecture)</PlatformTarget>
    <SelfContained>true</SelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AsciiStudio.Application/AsciiStudio.Application.csproj" />
    <Content Include="../../licenses/Unicode.txt" Link="licenses/Unicode.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
