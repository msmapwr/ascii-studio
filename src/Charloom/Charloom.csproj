<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.0-alpha.5</Version>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Charloom</RootNamespace>
    <Product>Charloom</Product>
    <AssemblyTitle>Charloom｜字织</AssemblyTitle>
    <Description>Offline ASCII / ANSI art studio</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Charloom.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <StudioArchitecture Condition="'$(StudioArchitecture)' == ''">x64</StudioArchitecture>
    <RuntimeIdentifier>win-$(StudioArchitecture)</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>$(StudioArchitecture)</PlatformTarget>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Services/*.cs" />
    <Compile Include="Services/MotionService.cs;Services/WindowPlacementService.cs;Services/IProjectSessionPage.cs" />
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../licenses/Unicode.txt" Link="licenses/Unicode.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <ProjectReference Include="../Charloom.Application/Charloom.Application.csproj" />
    <ProjectReference Include="../Charloom.Core/Charloom.Core.csproj" />
  </ItemGroup>
  <!-- WinUI generates these after item evaluation; output-copy items alone do not
       reliably reach dotnet publish for this unpackaged application. -->
  <Target Name="PublishWinUIResources" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')"
           Text="Missing WinUI resource index: $(TargetDir)$(AssemblyName).pri" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri"
                             RelativePath="$(AssemblyName).pri"
                             CopyToPublishDirectory="PreserveNewest" />
      <_StudioXbf Include="$(TargetDir)**/*.xbf" />
      <ResolvedFileToPublish Include="@(_StudioXbf)">
        <RelativePath>%(_StudioXbf.RecursiveDir)%(_StudioXbf.Filename)%(_StudioXbf.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
