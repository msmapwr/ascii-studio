<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>charloom-cli</AssemblyName>
    <Product>Charloom</Product>
    <Description>Offline ASCII / ANSI art studio</Description>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Version>1.0.0-alpha.4</Version>
    <StudioArchitecture Condition="'$(StudioArchitecture)' == ''">x64</StudioArchitecture>
    <RuntimeIdentifier>win-$(StudioArchitecture)</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget>$(StudioArchitecture)</PlatformTarget>
    <SelfContained>true</SelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Charloom.Application/Charloom.Application.csproj" />
    <Content Include="../../licenses/Unicode.txt" Link="licenses/Unicode.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Compatibility entry for the first public Charloom prerelease. Both apphosts
       load charloom-cli.dll; no second implementation or divergent settings. -->
  <Target Name="PublishLegacyCliEntry" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)charloom-cli.exe" DestinationFiles="$(PublishDir)asciistudio-cli.exe" />
  </Target>
</Project>
